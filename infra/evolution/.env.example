# Copy to ~/.config/antares-evolution/.env; generate independent secrets before use.
AUTHENTICATION_API_KEY=
POSTGRES_PASSWORD=
DATABASE_CONNECTION_URI=postgresql://evolution:REPLACE_PASSWORD@postgres:5432/evolution?schema=public
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://evolution-local.douglasgermano.com
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_CLIENT_NAME=antares_local
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_HISTORIC=true
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/0
CACHE_REDIS_PREFIX_KEY=antares_evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
TELEMETRY_ENABLED=false
PROMETHEUS_METRICS=false
DEL_INSTANCE=false
# Upstream 2.3.7 rejects requests without Origin with a restricted CORS list.
# API access still requires the apikey header. No cookie credentials.
CORS_ORIGIN=*
CORS_CREDENTIALS=false
LOG_LEVEL=ERROR,WARN,LOG
LOG_BAILEYS=error
LOG_COLOR=false
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
PUSHER_ENABLED=false
KAFKA_ENABLED=false
CHATWOOT_ENABLED=false
TYPEBOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false
S3_ENABLED=false
WEBHOOK_GLOBAL_ENABLED=false
LANGUAGE=pt-BR
TZ=America/Cuiaba
