APP_ENV=development
DATABASE_URL=postgresql+psycopg:///antarescrm
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_SECRET_KEY=replace-with-another-random-secret-of-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
PORT=5002
ALLOW_REGISTRATION=true
RATELIMIT_STORAGE_URI=memory://

# WhatsApp — Evolution API v2 (um servidor, uma instância por workspace)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# URL do BACKEND alcançável pela Evolution, sem /api/v1 no final.
WHATSAPP_WEBHOOK_BASE_URL=
# Opcional: segredo global adicional; cada instância já recebe seu próprio segredo.
WHATSAPP_WEBHOOK_SECRET=
